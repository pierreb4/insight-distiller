<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Insight distiller real-write canary — daily 00:07, mirrors systemd/distill-writecheck.timer.
     Confirms a sandboxed agent can land a file in staging/ (writes .last-write-check).
     stdout and stderr go to ~/Library/Logs/local.distill-writecheck.log. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>local.distill-writecheck</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>-c</string>
		<string>PATH="$HOME/.local/bin:$HOME/.pyenv/shims:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin" exec "$HOME/.claude/insights/distill.sh" --write-check >>"$HOME/Library/Logs/local.distill-writecheck.log" 2>&amp;1</string>
	</array>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>0</integer>
		<key>Minute</key>
		<integer>7</integer>
	</dict>
	<key>Nice</key>
	<integer>10</integer>
</dict>
</plist>
